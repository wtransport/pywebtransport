@final
class Endpoint:
    def __new__(cls, *, config: ClientConfig | ServerConfig, is_client: bool, waker: Waker) -> Self: ...
    def close(self) -> None: ...
    def connect(
        self, *, request_id: int, remote_address: tuple[str, int] | tuple[str, int, int, int], server_name: str
    ) -> None: ...
    def get_local_addresses(self) -> list[tuple[str, int]]: ...
    def handle_protocol_event(self, *, handle: int, request_id: int, event: tuple[int, Any]) -> None: ...
    def poll_runtime_events(self) -> list[tuple[int, Any]]: ...

@final
class Waker:
    def __new__(cls, *, fd: int) -> Self: ...
    def clear(self) -> None: ...

